# Server
PORT=8000
JWT_SECRET=change-this-to-a-long-random-string

# Roboflow autism detection model
ROBOFLOW_API_KEY=your_private_api_key
ROBOFLOW_MODEL_ID=autismdetection-wr5ri/autism-detection-age-3-5-3gjk8-2-rfdetr-small-t1
ROBOFLOW_URL=https://detect.roboflow.com

# Google sign-in (Firebase project used on the client)
GOOGLE_CLIENT_ID=your_google_web_client_id
FIREBASE_PROJECT_ID=your_firebase_project_id

# Google Gemini (AI suggestions)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash

# Forgot-password OTP: when 1, the OTP is returned in the API response (dev only)
DEV_OTP=1
